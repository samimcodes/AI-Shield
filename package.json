{
  "name": "@samimcodes/ai-shield",
  "version": "0.3.1",
  "description": "Enterprise-grade Express.js middleware to detect and poison unauthorized AI crawlers while preserving SEO for legitimate bots.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js",
      "require": "./dist/middleware.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "ai-shield": "dist/cli.cjs"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "clean": "rimraf dist",
    "website:dev": "npm --prefix website run dev",
    "website:build": "npm --prefix website run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai-crawler",
    "bot-detection",
    "middleware",
    "express",
    "typescript",
    "security",
    "honeypot",
    "data-poisoning"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ua-parser-js": "^1.0.38"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "@types/ua-parser-js": "^0.7.39",
    "@vitest/coverage-v8": "^1.6.0",
    "rimraf": "^5.0.7",
    "supertest": "^7.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.15.7",
    "typescript": "^5.5.2",
    "vitest": "^1.6.0"
  }
}
